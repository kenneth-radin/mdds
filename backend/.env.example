# ---- Backend configuration ----
# Copy this file to .env and fill in real values. NEVER commit .env.
PORT=4000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/mdss?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
