{
  "name": "predictive-maintenance-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "typecheck:mobile": "tsc -p tsconfig.mobile.json --noEmit",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:mobile && npm run typecheck:backend",
    "backend": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "ml:train": "npm --prefix backend run train:ml",
    "ml:verify": "npm --prefix backend run verify:ml",
    "ml:check": "node backend/scripts/ml-check.cjs",
    "expo:start": "expo start",
    "expo:tunnel": "expo start --tunnel"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "lucide-react": "^0.460.0",
    "query-string": "^7.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "~6.0.3",
    "vite": "^5.4.8"
  }
}
