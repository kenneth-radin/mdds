{
  "expo": {
    "name": "Maintenance Decision Support",
    "slug": "maintenance-decision-support",
    "version": "1.6.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "mdss",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plant.mdss"
    },
    "android": {
      "package": "com.plant.mdss",
      "versionCode": 15
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
